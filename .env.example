# =============================================================================
# WHAT IF - environment configuration
# Copy to .env and adjust. Never commit the real .env file.
# =============================================================================

# --- Database ---------------------------------------------------------------
POSTGRES_USER=whatif
POSTGRES_PASSWORD=whatif
POSTGRES_DB=whatif

# Used when running the API outside Docker (host = localhost).
# Inside Docker Compose this is set automatically to host `whatif-db`.
DATABASE_URL=postgresql+psycopg://whatif:whatif@localhost:5432/whatif

# --- Frontend ----------------------------------------------------------------
# Baked into the web build; browser needs a reachable URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM provider -------------------------------------------------------------
# mock       : deterministic demo responses, no key needed (default)
# openrouter : live generation via https://openrouter.ai
LLM_PROVIDER=mock
LLM_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_API_KEY=

# Free models on OpenRouter change over time. List current ones:
#   python scripts/list_openrouter_models.py            (all free models)
# or set LLM_MODEL to any "<publisher>/<model>:free" id.
#
# Free tiers rate-limit aggressively. Transient failures (429/502/503/504) are
# retried with exponential backoff (2s, 4s, 8s... capped at 30s) plus jitter, and
# a server-sent Retry-After wins up to 120s. Attempts = LLM_MAX_RETRIES + 1;
# the wait is paid per branch, so raising it trades latency for resilience.
# LLM_MAX_RETRIES=2
# LLM_REQUEST_TIMEOUT_SECONDS=90

# --- Possibility engine tuning (optional) ------------------------------------
# ENGINE_BEAM_WIDTH=6
# ENGINE_MIN_CANDIDATES=3
# ENGINE_DEDUP_THRESHOLD=0.72
# How many consequence orders the projection prompt is asked to reach.
# ENGINE_MAX_CAUSAL_DEPTH=2
# Revise-loop bound: branches that fail review get this many repair passes.
# Set to 0 to disable the loop entirely.
# ENGINE_MAX_REVISE_ITERATIONS=2
# How deep the user may expand the graph. Depth 0 is reality, 2 is the first
# row of outcomes; each expansion adds 2. Raising this costs tokens per click.
# ENGINE_MAX_DEPTH=4

# --- Deferred infrastructure (not used yet) -----------------------------------
# Redis arrives when the possibility engine needs caching/shared state.
# REDIS_URL=redis://whatif-redis:6379/0
